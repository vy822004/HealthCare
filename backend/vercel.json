  {                                                                                                                                                                                                  
      "version": 2,                                                                                                                                                                                    
      "builds": [                                                                                                                                                                                      
        {                                                                                                                                                                                              
          "src": "src/server.js",                                                                                                                                                                      
          "use": "@vercel/node",
          "config": {
            "includeFiles": "node_modules/pdf-parse/lib/pdf.js/**/*.js"
          }
        }                                                                                                                                                                                              
      ],                                                                                                                                                                                               
      "rewrites": [                                                                                                                                                                                    
        {                                                                                                                                                                                              
          "source": "/(.*)",                                                                                                                                                                           
          "destination": "/src/server.js"                                                                                                                                                              
        }                                                                                                                                                                                              
      ]                                                                                                                                                                                                
    }
